# Server
PORT=4000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/metriq

# MinIO (S3-compatible)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=metriq_admin
MINIO_SECRET_KEY=metriq_secret
MINIO_BUCKET=metriq-evidence

# In production, set this to the public URL Coolify exposes MinIO on.
# Presigned URLs returned to the browser will use this host instead of
# the internal container hostname.
# Example: https://storage.yourdomain.com
# Leave blank for local development.
MINIO_PUBLIC_URL=

# OpenAI
OPENAI_API_KEY=sk-...

# JWT
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string_at_least_64_chars
JWT_EXPIRES_IN=7d
