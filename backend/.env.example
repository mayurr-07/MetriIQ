# Server
PORT=4000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/metriq

# MinIO (S3-compatible — change these 4 vars to point to real S3 when ready)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=metriq_admin
MINIO_SECRET_KEY=metriq_secret
MINIO_BUCKET=metriq-evidence

# OpenAI
OPENAI_API_KEY=sk-...

# JWT
JWT_SECRET=replace_with_a_long_random_string_at_least_64_chars
JWT_EXPIRES_IN=7d
